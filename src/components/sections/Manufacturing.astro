---
import Container from "../ui/Container.astro";

const capabilities = [
  {
    index: "01",
    title: "Research & development",
    copy: "Laser projection, interactive whiteboards and interactive flat panels are developed and engineered in-house.",
  },
  {
    index: "02",
    title: "Production",
    copy: "The company industrial park includes complete projector and optical engine production lines.",
  },
  {
    index: "03",
    title: "Testing",
    copy: "Test and inspection equipment supports production and product verification.",
  },
];
---

<section class="border-t border-[var(--color-line)] bg-white py-20 sm:py-24 lg:py-28">
  <Container>
    <div class="grid gap-8 lg:grid-cols-[1.2fr_.8fr] lg:items-end">
      <div>
        <p class="eyebrow">Manufacturing</p>
        <h2 class="display-lg mt-5 max-w-[16ch]">From optical engine to finished projector.</h2>
      </div>
      <div class="lg:justify-self-end">
        <p class="spec-value text-5xl font-semibold tracking-[-0.05em] text-[var(--color-primary)]">2017</p>
        <p class="mt-1 text-[0.62rem] font-bold uppercase tracking-[0.18em] text-[var(--color-muted)]">Established in Shenzhen</p>
      </div>
    </div>

    <div class="mt-14 grid gap-px border border-[var(--color-line)] bg-[var(--color-line)] md:grid-cols-3">
      {capabilities.map((item) => (
        <article class="bg-white p-7 sm:p-9 lg:p-10">
          <p class="spec-value text-[0.62rem] font-bold tracking-[0.16em] text-[var(--color-primary)]">{item.index}</p>
          <h3 class="mt-6 text-xl font-bold tracking-[-0.02em]">{item.title}</h3>
          <p class="mt-4 text-sm leading-7 text-[var(--color-muted)]">{item.copy}</p>
        </article>
      ))}
    </div>

    <p class="mt-7 max-w-3xl text-sm leading-7 text-[var(--color-muted)]">
      DUALSHINE's product scope also includes interactive whiteboards and interactive flat panels for education and business environments.
    </p>
  </Container>
</section>
