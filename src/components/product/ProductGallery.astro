---
interface ProductImage {
  src: string;
  alt: string;
}

interface Props {
  images: ProductImage[];
}

const { images } = Astro.props;
---

<div class="flex min-h-[24rem] items-center justify-center bg-[#d2d3d1] p-8 sm:p-12 lg:min-h-[34rem] lg:p-14">
  <img
    src={images[0].src}
    alt={images[0].alt}
    width="1200"
    height="1034"
    class="h-auto w-full object-contain"
  />
</div>
