---
interface Specification {
  label: string;
  value: string;
}

interface Props {
  specifications: Specification[];
}

const { specifications } = Astro.props;
---

<dl class="grid border-t border-[var(--color-ink)]/20 sm:grid-cols-2">
  {specifications.map((specification, index) => (
    <div class:list={["border-b border-[var(--color-line)] py-5 sm:py-6", index % 2 === 1 && "sm:border-l sm:pl-7"]}>
      <dt class="text-[0.6rem] font-bold uppercase tracking-[0.16em] text-[var(--color-steel)]">{specification.label}</dt>
      <dd class="spec-value mt-2 text-lg font-semibold text-[var(--color-ink)]">{specification.value}</dd>
    </div>
  ))}
</dl>
