---
import Container from "../ui/Container.astro";

const specifications = [
  { label: "Optical engine", value: "0.65-inch single-chip DLP" },
  { label: "Light source", value: "Laser" },
  { label: "Brightness", value: "5,000–6,500 lm" },
  { label: "Resolution", value: "1920 × 1080" },
  { label: "Aspect ratio", value: "16:10 / 16:9" },
  { label: "Lens options", value: "Fixed / motorized" },
];

const models = ["DX-50", "DX-60", "DX-70"];
---

<section class="bg-[var(--color-ink)] py-20 text-white sm:py-24 lg:py-28">
  <Container class="grid gap-14 lg:grid-cols-[.82fr_1.18fr] lg:gap-20">
    <div>
      <p class="eyebrow">DX Series</p>
      <h2 class="display-lg mt-5 max-w-[12ch]">One platform. Three models.</h2>
      <p class="mt-7 max-w-md text-base leading-7 text-white/65">
        A 1080p laser platform for large meeting rooms, school lecture theatres and stage environments, with fixed or motorized lens options.
      </p>
      <a href="/products/dx-series/" class="rule-link mt-8 text-[var(--color-accent)]">View DX Series <span aria-hidden="true">→</span></a>
    </div>

    <div>
      <dl class="grid grid-cols-1 border-t border-white/12 sm:grid-cols-2">
        {specifications.map((item, index) => (
          <div class:list={["border-b border-white/12 py-5 sm:py-6", index % 2 === 1 && "sm:border-l sm:pl-7"]}>
            <dt class="text-[0.6rem] font-bold uppercase tracking-[0.17em] text-white/38">{item.label}</dt>
            <dd class="spec-value mt-2 text-lg font-semibold text-white sm:text-xl">{item.value}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-9 grid grid-cols-3 border-t border-white/12 pt-6">
        {models.map((model, index) => (
          <div class:list={[index > 0 && "border-l border-white/12 pl-5 sm:pl-7"]}>
            <p class="spec-value text-2xl font-semibold text-white/85 sm:text-3xl">{model}</p>
            <p class="mt-1 text-[0.58rem] font-bold uppercase tracking-[0.16em] text-white/30">Series model</p>
          </div>
        ))}
      </div>
      <p class="mt-5 text-xs leading-5 text-white/35">Model-specific configurations are available on request.</p>
    </div>
  </Container>
</section>
