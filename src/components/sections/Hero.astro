---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";

const stats = [
  { value: "5,000–6,500", unit: "lm", label: "DX series brightness" },
  { value: "1920 × 1080", unit: "", label: "Full HD resolution" },
  { value: "0.65-inch", unit: "DLP", label: "Single-chip optical engine" },
  { value: "Laser", unit: "", label: "Light source" },
];
---

<section class="overflow-hidden bg-[var(--color-ink)] text-white">
  <div class="grid lg:grid-cols-[1.06fr_.94fr]">
    <div class="flex max-w-3xl flex-col justify-center px-5 py-16 sm:px-8 sm:py-20 lg:min-h-[40rem] lg:py-24 lg:pl-[max(3.5rem,calc((100vw-88rem)/2+3.5rem))] lg:pr-16">
      <p class="eyebrow">Laser projection systems</p>
      <h1 class="display-xl mt-6 max-w-[13ch] font-bold">Laser projection for the big room.</h1>
      <p class="mt-7 max-w-xl text-lg leading-8 text-white/70 sm:text-xl sm:leading-9">
        DUALSHINE develops and manufactures laser projectors and interactive display systems for education, business and large-venue applications.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <Button href="/products/dx-series/" >Explore DX Series</Button>
        <Button href="/contact/" variant="inverse">Talk to our team</Button>
      </div>
      <p class="mt-10 text-[0.68rem] font-bold uppercase tracking-[0.18em] text-white/38">Shenzhen, China · Established 2017</p>
    </div>

    <div class="relative flex min-h-[26rem] items-center justify-center border-t border-white/10 bg-[#d2d3d1] lg:min-h-[40rem] lg:border-l lg:border-t-0">
      <div class="absolute left-6 top-6 z-10 flex items-center gap-3 text-[0.62rem] font-bold uppercase tracking-[0.18em] text-[var(--color-ink)]/55">
        <span class="h-px w-8 bg-[var(--color-primary)]"></span>
        DX Series / 001
      </div>
      <img
        src="/media/products/dx-series.jpg"
        alt="DUALSHINE DX Series black laser engineering projector"
        width="2200"
        height="1895"
        fetchpriority="high"
        class="h-full w-full object-contain px-7 py-20 sm:px-12 lg:px-16 lg:py-16"
      />
      <div class="absolute inset-x-6 bottom-6 z-10 flex items-end justify-between gap-6 text-[0.62rem] font-bold uppercase tracking-[0.16em] text-[var(--color-ink)]/55">
        <p>DX-50 / DX-60 / DX-70</p>
        <p class="spec-value">0.65-inch DLP</p>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <Container class="grid grid-cols-2 divide-x divide-white/10 lg:grid-cols-4">
      {stats.map((stat, index) => (
        <div class:list={["py-6 lg:py-7", index > 1 && "border-t border-white/10 lg:border-t-0", index > 0 && "pl-5 sm:pl-8"]}>
          <p class="spec-value text-xl font-semibold text-white sm:text-2xl">
            {stat.value}{stat.unit && <span class="ml-1.5 text-[0.62rem] font-bold uppercase tracking-[0.14em] text-white/40">{stat.unit}</span>}
          </p>
          <p class="mt-1.5 text-[0.62rem] font-bold uppercase tracking-[0.15em] text-white/35">{stat.label}</p>
        </div>
      ))}
    </Container>
  </div>
</section>
