---
import ContactCta from "../components/sections/ContactCta.astro";
import Container from "../components/ui/Container.astro";
import company from "../data/company.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { makePageTitle } from "../lib/seo";
---
<BaseLayout title={makePageTitle("About")} description={company.description}>
  <Container class="forge-basic">
    <h1 class="forge-title">About {company.shortName || company.name}</h1>
    <p class="forge-intro">{company.description}</p>
    {(company.founded || company.location) && (
      <dl class="forge-facts">
        {company.founded && <div><dt>Established</dt><dd>{company.founded}</dd></div>}
        {company.location && <div><dt>Location</dt><dd>{company.location}</dd></div>}
      </dl>
    )}
  </Container>
  <ContactCta />
</BaseLayout>
