---
import Container from "../components/ui/Container.astro";
import company from "../data/company.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { makePageTitle } from "../lib/seo";

const phoneHref = company.phone.replace(/[^\d+]/g, "");
const whatsappHref = company.whatsapp.replace(/[^\d]/g, "");
---
<BaseLayout title={makePageTitle("Contact")} description={`Contact ${company.name}.`}>
  <Container class="forge-basic">
    <h1 class="forge-title">Contact</h1>
    <p class="forge-intro">{company.name}</p>
    <dl class="forge-facts">
      {company.email && <div><dt>Email</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd></div>}
      {phoneHref && <div><dt>Telephone</dt><dd><a href={`tel:${phoneHref}`}>{company.phone}</a></dd></div>}
      {whatsappHref && <div><dt>WhatsApp</dt><dd><a href={`https://wa.me/${whatsappHref}`}>{company.whatsapp}</a></dd></div>}
      {company.address && <div><dt>Address</dt><dd>{company.address}</dd></div>}
    </dl>
  </Container>
</BaseLayout>
