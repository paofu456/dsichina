---
import Container from "../ui/Container.astro";

const products = [
  {
    index: "01",
    name: "DX Series",
    type: "Laser engineering projector",
    image: "/media/products/dx-series.jpg",
    alt: "DUALSHINE DX Series laser engineering projector",
    fit: "Large meeting rooms, lecture theatres and stages",
    spec: "5,000–6,500 lm · 1920 × 1080",
    href: "/products/dx-series/",
    action: "View the series",
  },
  {
    index: "02",
    name: "Laser long-throw",
    type: "Long-distance projection",
    image: "/media/products/long-throw.jpg",
    alt: "DUALSHINE white laser long-throw projector",
    fit: "Long-throw installations with manual focus",
    spec: "5,000–6,000 lm",
    href: "/contact/",
    action: "Request details",
  },
  {
    index: "03",
    name: "High-brightness business",
    type: "Laser engineering projector",
    image: "/media/products/high-brightness.jpg",
    alt: "DUALSHINE high-brightness business laser projector",
    fit: "Business and engineering projection",
    spec: "High-brightness laser platform",
    href: "/contact/",
    action: "Request details",
  },
];
---

<section class="border-t border-[var(--color-line)] bg-[var(--color-surface)] py-20 sm:py-24 lg:py-28">
  <Container>
    <div class="grid gap-8 lg:grid-cols-[1.15fr_.85fr] lg:items-end">
      <div>
        <p class="eyebrow">The range</p>
        <h2 class="display-lg mt-5 max-w-[18ch]">Three laser platforms. One engineering focus.</h2>
      </div>
      <p class="max-w-xl text-base leading-7 text-[var(--color-muted)] lg:justify-self-end">
        DX Series anchors the range for large rooms and stages. Long-throw and high-brightness models extend it for specific installation needs.
      </p>
    </div>

    <div class="mt-12 border-t border-[var(--color-ink)]/20">
      {products.map((product) => (
        <a href={product.href} class="group grid gap-5 border-b border-[var(--color-line)] py-7 transition-colors hover:bg-white/60 md:grid-cols-[2.5rem_1.25fr_1fr_1fr_auto] md:items-center md:gap-7 lg:py-8">
          <span class="spec-value text-[0.68rem] font-bold tracking-[0.14em] text-[var(--color-steel)]">{product.index}</span>
          <div class="flex items-center gap-5">
            <div class="flex h-16 w-24 shrink-0 items-center justify-center bg-white p-2">
              <img src={product.image} alt={product.alt} width="240" height="160" loading="lazy" class="h-full w-full object-contain" />
            </div>
            <div>
              <h3 class="text-xl font-bold tracking-[-0.02em]">{product.name}</h3>
              <p class="mt-1 text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-muted)]">{product.type}</p>
            </div>
          </div>
          <div>
            <p class="text-[0.6rem] font-bold uppercase tracking-[0.16em] text-[var(--color-steel)]">Best for</p>
            <p class="mt-1.5 text-sm leading-6 text-[var(--color-muted)]">{product.fit}</p>
          </div>
          <div>
            <p class="text-[0.6rem] font-bold uppercase tracking-[0.16em] text-[var(--color-steel)]">Key specification</p>
            <p class="spec-value mt-1.5 text-sm font-semibold text-[var(--color-ink)]">{product.spec}</p>
          </div>
          <span class="inline-flex items-center gap-2 text-[0.65rem] font-bold uppercase tracking-[0.13em] text-[var(--color-primary)] md:justify-self-end">
            {product.action}
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </span>
        </a>
      ))}
    </div>
  </Container>
</section>
