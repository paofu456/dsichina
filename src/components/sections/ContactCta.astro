---
import company from "../../data/company.json";
import Container from "../ui/Container.astro";

const phoneHref = `tel:+86${company.phone.replace(/[^0-9]/g, "").replace(/^0/, "")}`;
---

<section class="bg-[var(--color-primary)] py-16 text-white sm:py-20 lg:py-24">
  <Container class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-end lg:gap-20">
    <div>
      <p class="text-[0.68rem] font-bold uppercase tracking-[0.2em] text-white/60">Laser projection division</p>
      <h2 class="display-lg mt-5 max-w-[13ch]">Talk to the team behind the projector.</h2>
    </div>
    <div class="lg:justify-self-end">
      <a href={phoneHref} class="spec-value block text-3xl font-semibold tracking-[-0.03em] text-white transition-opacity hover:opacity-75 sm:text-4xl lg:text-5xl">{company.phone}</a>
      <p class="mt-4 max-w-md text-sm leading-6 text-white/75">{company.address}</p>
      <a href="/contact/" class="mt-7 inline-flex items-center gap-3 border-b border-white/50 pb-2 text-[0.68rem] font-bold uppercase tracking-[0.15em] text-white transition-colors hover:border-white">
        Contact details <span aria-hidden="true">→</span>
      </a>
    </div>
  </Container>
</section>
